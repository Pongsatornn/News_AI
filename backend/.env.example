GROQ_API_KEY=gsk_your_key_here

# token สำหรับ endpoint บันทึก/ลบ/สรุป — ใส่ค่าเดียวกับ VITE_API_TOKEN ใน frontend/.env
# สร้างได้ด้วย: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# ไม่บังคับ
# GROQ_MODEL=qwen/qwen3.8-27b   โมเดลที่ใช้สรุป/ตอบคำถาม (Groq ถอดโมเดลออกเป็นระยะ — ดูรายชื่อที่ console.groq.com)
# AI_RATE_LIMIT_PER_MIN=20      จำนวนครั้งสูงสุดต่อ IP ต่อนาทีของ endpoint ที่ใช้โควตา AI (0 = ไม่จำกัด)
# FETCH_INTERVAL_MINUTES=30  ดึงข่าวใหม่จาก RSS อัตโนมัติทุกกี่นาทีตอนเปิด api_server.py (0 = ปิด)
# AUTO_SUMMARY_PER_RUN=5     ให้ AI สรุปข่าวใหม่รอไว้กี่ข่าวต่อรอบการดึงข่าว (0 = ปิด)
# BRIEFING_INTERVAL_HOURS=3  สร้างสรุปข่าวเด่นใหม่ทุกกี่ชั่วโมง (0 = ไม่สร้างเอง)
# RETENTION_DAYS=30          ลบข่าวที่บันทึกไว้เกินกี่วัน ข่าวที่กดบันทึกจากหน้าค้นหาจะไม่ถูกลบ (0 = เก็บไว้ตลอด)
# FLASK_DEBUG=1          เปิด debugger ตอนพัฒนา (ห้ามใช้คู่กับ API_HOST=0.0.0.0)
# API_HOST=127.0.0.1
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
